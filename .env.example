# ─────────────────────────────────────────────────────────────
# Sea-Info Agent 환경변수
# 1) 이 파일을 복사해서 이름을 .env 로 바꿔요:   cp .env.example .env   (Windows: copy .env.example .env)
# 2) 아래 빈칸("")에 값을 넣어요. 비워 두면 그 기능은 '로컬 대체 모드'로 돌아가요.
# 3) .env 는 깃에 올리지 않아요(.gitignore). 배포할 때는 배포 사이트의 환경변수 화면에 같은 이름으로 넣어요.
# ─────────────────────────────────────────────────────────────

# [기본] local 이면 시험용 로그인·보기 모드·개발용 인증 링크 표시가 켜져요. 배포할 때는 production
APP_ENV=local

# [화면 → API] Streamlit이 부를 FastAPI 주소
BACKEND_URL=http://localhost:8000
# 메일 속 인증 링크가 열 화면 주소 (Supabase 대시보드의 Site URL과 똑같이)
PUBLIC_SITE_URL=http://localhost:8501

# [저장소] 앱 데이터는 SQLite 파일, 빠른 값은 Redis(docker compose up -d 로 켜요)
DATABASE_URL=sqlite:///./data/sea_info.db
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
SESSION_DAYS=7
# 관리자로 볼 이메일 (쉼표로 여러 명). Supabase 사용자 app_metadata.role=admin 도 관리자로 봐요
ADMIN_EMAILS=admin@example.com

# [Gemini] 생물 분석 · 뉴스 요약 — Google AI Studio에서 발급
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000

# [Supabase] 가입 · 로그인 · 메일 인증(링크) · 권한에만 써요 — Supabase 대시보드 > Project Settings > API
# 인증 메일 템플릿 · Gmail SMTP 연결은 Supabase 대시보드에서 해요 (설치 가이드 3장)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# [Google SMTP] 제보 알림 · 답변 알림 메일, Supabase를 안 쓸 때의 인증 링크 메일 — Gmail 2단계 인증을 켠 뒤 '앱 비밀번호' 발급
# (Supabase를 쓰면 인증 메일은 Supabase가 보내요. 같은 Gmail 계정을 Supabase SMTP 설정에도 넣어요)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# 새 제보가 오면 알림을 받을 담당 그룹 메일
OPS_EMAIL=

# [물때] 공공 데이터 API 키 (선택). 비우면 예시 물때를 보여줘요
TIDE_API_KEY=

# [Jira] 제보 → 이슈 자동 생성 — Atlassian 계정 > 보안 > API 토큰
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE_BUG=Bug
JIRA_ISSUE_TYPE_DEFAULT=Task
# Jira 웹훅 주소 끝에 ?secret=이값 을 붙여요 (배포 후 이슈 완료를 자동으로 받을 때)
JIRA_WEBHOOK_SECRET=
